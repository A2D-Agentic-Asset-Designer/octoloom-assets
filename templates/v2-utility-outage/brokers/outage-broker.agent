# @dialect: AGENTFABRIC=1.0
# Utility Outage (fully mocked): A known outage gets status updates and a bill credit; an unknown one gets a ticket and a field crew. Three agents, two tool servers. Fully mocked: the LLM is an A²D LLM mock too, so no OpenAI key is needed.
# Upstreams and the LLM are A2D mocks; see README.md for test prompts.

system:
  instructions: "You are the outage desk of a power utility. Send a crew only when the grid does not already know the outage."

config:
  agent_name: "outage-broker"
  default_llm: @llm.default

llm:
  default:
    target: "llm://openai_connection"
    kind: "OpenAI"
    model: "gpt-5-mini"
    reasoning_effort: "MINIMAL"

actions:
  get_outage:
    target: "mcp://grid_mcp_connection"
    kind: "mcp:tool"
    tool_name: "get_outage"
  create_ticket:
    target: "mcp://field_ticket_mcp_connection"
    kind: "mcp:tool"
    tool_name: "create_ticket"
    inputs:
      address_id: string
      symptom: string
  comms_agent:
    target: "a2a://comms_agent_connection"
    kind: "a2a:send_message"
  credit_agent:
    target: "a2a://credit_agent_connection"
    kind: "a2a:send_message"
  crew_agent:
    target: "a2a://crew_agent_connection"
    kind: "a2a:send_message"

trigger outageBrokerTrigger:
  kind: "a2a"
  target: "brokers://octo_uo2_outage_broker/a2a"
  on_message: ->
    transition to @generator.extractOutage

# Step 1: one LLM call turns the report into an address id and a symptom.
generator extractOutage:
  description: "Extracts the address id and the symptom."
  label: "Extract Outage"
  system:
    instructions: |
      Extract the address id (for example ADDR-31) and a short symptom from the message.
      Use "UNKNOWN" when no address id is present.
  prompt: ->
    | {!@request.payload.message.parts[0].text}
  outputs:
    properties:
      address_id:
        type: "string"
        description: "Address id, e.g. ADDR-31, or UNKNOWN"
      symptom:
        type: "string"
        description: "What the customer sees"
  on_exit: ->
    transition to @subagent.outageGate

# Step 2: a gate. The subagent asks the Grid MCP whether the outage is known.
subagent outageGate:
  description: "Looks up known outages with the Grid MCP."
  label: "Outage Gate"
  system:
    instructions: |
      Call the outage tool for the address and report whether the outage is already known.
      Set known to "yes" only when the tool returns known true.
  reasoning:
    instructions: ->
      | Address: {!@generator.extractOutage.output.address_id}. Report: {!@request.payload.message.parts[0].text}
    actions:
      check: @actions.get_outage
    max_number_of_loops: 3
    outputs:
      properties:
        known:
          type: "string"
          description: "Whether the outage is already known"
          enum:
            - "yes"
            - "no"
        detail:
          type: "string"
          description: "Outage detail from the tool"
  on_exit: ->
    transition to @router.outageRouter

router outageRouter:
  description: "Known outages get updates and a credit; new ones get a ticket and a crew."
  routes:
    - target: @subagent.informCustomer
      when: @subagent.outageGate.output.known == "yes"
      label: "Known"
  otherwise:
    target: @executor.createTicket

# Step 3a: a known outage. Updates, then a bill credit.
subagent informCustomer:
  description: "Enables status updates through the Customer Comms agent."
  label: "Inform Customer"
  reasoning:
    instructions: ->
      | Enable outage updates for {!@generator.extractOutage.output.address_id}. Report: {!@request.payload.message.parts[0].text}
    actions:
      updates: @actions.comms_agent
  on_exit: ->
    transition to @subagent.offerCredit

subagent offerCredit:
  description: "Applies the outage bill credit through the Billing Credit agent."
  label: "Offer Credit"
  reasoning:
    instructions: ->
      | Apply the outage bill credit for {!@generator.extractOutage.output.address_id}. Report: {!@request.payload.message.parts[0].text}
    actions:
      credit: @actions.credit_agent
  on_exit: ->
    transition to @echo.knownOutage

echo knownOutage:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({messageId: uuid(), parts: [a2a.textPart("Known " + @subagent.outageGate.output.detail + ". " + @subagent.informCustomer.output + " " + @subagent.offerCredit.output)]})

# Step 3b: a new problem. No LLM for the ticket; the crew is dispatched by the Crew Dispatch agent.
executor createTicket:
  description: "Creates the field ticket."
  do: ->
    run @actions.create_ticket
      with address_id = @generator.extractOutage.output.address_id
      with symptom = @generator.extractOutage.output.symptom
  on_exit: ->
    transition to @subagent.dispatchCrew

subagent dispatchCrew:
  description: "Dispatches a field crew."
  label: "Dispatch Crew"
  reasoning:
    instructions: ->
      | Send a field crew to {!@generator.extractOutage.output.address_id}: {!@generator.extractOutage.output.symptom}. Report: {!@request.payload.message.parts[0].text}
    actions:
      crew: @actions.crew_agent
  on_exit: ->
    transition to @echo.crewDispatched

echo crewDispatched:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({messageId: uuid(), parts: [a2a.textPart("New problem at " + @generator.extractOutage.output.address_id + ": a field ticket is open. " + @subagent.dispatchCrew.output)]})
