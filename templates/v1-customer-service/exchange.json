{
  "main": "agent-network.yaml",
  "name": "customer-service-v1",
  "classifier": "agent-network",
  "descriptorVersion": "1.0.0",
  "apiVersion": "v1",
  "tags": [
    "octoloom-example"
  ],
  "metadata": {
    "variables": {
      "ingressgw": {
        "url": {
          "description": "Ingress gateway base URL (the broker is served under it)",
          "default": "",
          "secret": false
        }
      },
      "openai": {
        "apiKey": {
          "description": "OpenAI API key (secret, injected at deploy time)",
          "default": "",
          "secret": true
        }
      },
      "crmMcp": {
        "url": {
          "description": "CRM MCP (A2D mock) base URL",
          "default": "https://www.a2d-ai.com/api/platform/31f7ded2-aede-4897-8c52-19b294630e28/",
          "secret": false
        }
      },
      "orderStatusAgent": {
        "url": {
          "description": "Order Status Agent (A2D mock, A2A 0.3.0) URL",
          "default": "https://www.a2d-ai.com/api/platform/9d3edc31-a603-4aa6-aee9-990cb856467b/a2a",
          "secret": false
        }
      },
      "returnsAgent": {
        "url": {
          "description": "Returns Agent (A2D mock, A2A 0.3.0) URL",
          "default": "https://www.a2d-ai.com/api/platform/1950885c-191f-4e08-a1b5-1aa2654100a7/a2a",
          "secret": false
        }
      },
      "billingAgent": {
        "url": {
          "description": "Billing Agent (A2D mock, A2A 0.3.0) URL",
          "default": "https://www.a2d-ai.com/api/platform/7798938a-e34c-40db-bea2-f95f58830928/a2a",
          "secret": false
        }
      },
      "loyaltyAgent": {
        "url": {
          "description": "Loyalty Agent (A2D mock, A2A 0.3.0) URL",
          "default": "https://www.a2d-ai.com/api/platform/bc04526d-59b6-4e1c-816f-f93f8a1f01bd/a2a",
          "secret": false
        }
      }
    }
  },
  "dependencies": [],
  "groupId": "${organizationId}",
  "assetId": "customer-service-v1",
  "version": "1.0.0"
}
